{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CamNote",
  "version": "0.4.1",
  "identifier": "local.camnote.desktop",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "CamNote", "width": 1220, "height": 820, "minWidth": 820, "minHeight": 640, "backgroundColor": "#f5f5f7" }],
    "security": { "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["app"], "macOS": { "minimumSystemVersion": "13.0", "infoPlist": "Info.plist" } }
}
